---
// Patrón pipeline del manual: cajitas mono unidas por líneas. Diagramático, decorativo.
interface Props { pasos?: string[]; class?: string }
const { pasos = ["tus datos", "se ordenan", "se conectan", "tablero", "tu negocio"], class: clase } = Astro.props;
---
<ol class:list={["pipeline", clase]} aria-label="Cómo se conectan las piezas">
  {pasos.map((p, i) => <li class:list={{ fin: i === pasos.length - 1 }}>{p}</li>)}
</ol>

<style>
  .pipeline {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: nowrap; /* una sola fila: con menos de 5 pasos cortos entra en 360 px */
    gap: var(--space-3) var(--space-4);
    font-weight: 700;
    font-size: var(--fs-small);
  }
  .pipeline li {
    position: relative;
    white-space: nowrap;
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--pino);
    border-radius: var(--radius-box);
    background: var(--crema);
    color: var(--pino);
  }
  .pipeline li:not(:last-child)::after {
    content: "" / "";
    position: absolute;
    left: 100%;
    top: 50%;
    width: var(--space-4);
    border-top: 2px solid var(--pino);
  }
  .pipeline .fin { background: var(--pino); color: var(--crema); }
  :global(.oscura) .pipeline li:not(:last-child)::after { border-top-color: var(--crema); }
  :global(.oscura) .pipeline .fin { background: var(--salvia); color: var(--pino); }
  /* Sobre pino (escenario): el conector va en crema y el cierre en salvia, para que no se fundan con el fondo */
  :global(.tema-pino) .pipeline li:not(:last-child)::after { border-top-color: var(--crema); }
  :global(.tema-pino) .pipeline .fin { background: var(--salvia); color: var(--pino); }

  /* Celular angosto: en vertical, con el conector hacia abajo */
  @media (max-width: 30rem) {
    .pipeline { flex-direction: column; align-items: flex-start; gap: var(--space-4); }
    .pipeline li:not(:last-child)::after {
      left: var(--space-4);
      top: 100%;
      width: 0;
      height: var(--space-4);
      border-top: 0;
      border-left: 2px solid var(--pino);
    }
  }
</style>
