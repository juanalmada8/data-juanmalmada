---
import { resaltar } from "../../lib/resaltar";
interface Props { codigo: string; lang: string; etiqueta?: string }
const { codigo, lang, etiqueta } = Astro.props;
const lineas = resaltar(codigo.trim(), lang);
---
<figure class="codigo">
  {etiqueta && <figcaption class="mono">{etiqueta}</figcaption>}
  <pre><code>{lineas.map((l) => <span class="l" set:html={l || " "} />)}</code></pre>
</figure>

<style>
  .codigo {
    border: 1px solid var(--ide-borde);
    border-radius: var(--radius-box);
    background: var(--ide-panel);
    overflow: hidden;
  }
  figcaption {
    padding: var(--space-2) var(--space-4);
    border-bottom: 1px solid var(--ide-borde);
    color: var(--ide-texto-2);
    font-size: var(--fs-ui);
  }
  pre {
    margin: 0;
    padding: var(--space-4) 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--fs-code);
    line-height: 1.75;
    counter-reset: linea;
  }
  code { font-size: inherit; display: grid; }
  .l {
    display: block;
    padding-right: var(--space-6);
    white-space: pre;
  }
  .l::before {
    counter-increment: linea;
    content: counter(linea) / "";
    display: inline-block;
    width: 3.5ch;
    margin-right: var(--space-4);
    padding-right: var(--space-2);
    text-align: right;
    color: var(--ide-texto-2);
    opacity: .6;
    user-select: none;
  }
  .codigo :global(.k) { color: var(--sx-clave); }
  .codigo :global(.s) { color: var(--sx-texto); }
  .codigo :global(.c) { color: var(--sx-coment); font-style: italic; }
  .codigo :global(.f) { color: var(--sx-func); font-weight: 600; }
  .codigo :global(.p) { color: var(--musgo); }
</style>
