---
// El armazón del editor. Sin JS: explorador de links + todos los archivos apilados (se lee como una página larga).
// Con JS (editor.ts): pestañas, un archivo por vez, terminal con comandos y explorador como cajón en el celular.
import Icono from "../Icono.astro";
import { archivos, nombre } from "../../data/archivos";
import { contacto, sitio } from "../../data/sitio";

const sueltos = archivos.filter((a) => !a.carpeta);
const carpetas = [...new Set(archivos.filter((a) => a.carpeta).map((a) => a.carpeta!))];
// El orden del explorador: hola.md, carpetas, después el resto de archivos sueltos.
const [hola, ...restoSueltos] = sueltos;
---
<div class="ide" data-ide>
  <header class="barra-titulo">
    <button class="btn-archivos mono" type="button" aria-expanded="false" aria-controls="explorador" hidden>
      <span aria-hidden="true">☰</span> archivos
    </button>
    <a class="marca" href="#hola" data-abrir="hola" aria-label={`${sitio.nombre}, inicio`}>
      <Icono variante="sin-fondo" ancho="30px" />
    </a>
    <p class="ruta mono" aria-hidden="true">~/juanma/<span data-ruta-actual>hola.md</span></p>
    <a class="escribime mono" href={contacto.whatsapp} target="_blank" rel="noopener noreferrer">Escribime</a>
  </header>


  <div class="editor">
    <nav class="pestanas mono" data-pestanas aria-label="Archivos abiertos" hidden></nav>
    <main id="contenido" class="paneles" data-paneles>
      <slot />
    </main>
  </div>

  <nav id="explorador" class="explorador" aria-label="Archivos del sitio">
    <p class="exp-tit mono">explorador</p>
    <ul class="arbol mono">
      <li><a href={`#${hola.id}`} data-abrir={hola.id} data-ext={hola.ext}><span class="ext" aria-hidden="true">{hola.ext}</span>{nombre(hola)}</a></li>
      {carpetas.map((c) => (
        <li>
          <details open>
            <summary><span class="flecha" aria-hidden="true">▸</span>{c}/</summary>
            <ul>
              {archivos.filter((a) => a.carpeta === c).map((a) => (
                <li><a href={`#${a.id}`} data-abrir={a.id} data-ext={a.ext}><span class="ext" aria-hidden="true">{a.ext}</span><span class="nom" title={a.ruta}>{nombre(a)}</span>{a.borrador && <><span class="punto" aria-hidden="true">●</span><span class="sr-only"> (borrador)</span></>}</a></li>
              ))}
            </ul>
          </details>
        </li>
      ))}
      {restoSueltos.map((a) => (
        <li><a href={`#${a.id}`} data-abrir={a.id} data-ext={a.ext}><span class="ext" aria-hidden="true">{a.ext}</span>{nombre(a)}</a></li>
      ))}
    </ul>
    <p class="exp-pie mono">{sitio.base}<br />100% remoto</p>
  </nav>

  <section class="terminal" data-terminal aria-label="Terminal">
    <div class="term-barra mono">
      <span>terminal</span>
      <span class="term-ayuda">escribí <code>ayuda</code></span>
      <button class="term-toggle" type="button" data-term-toggle aria-expanded="true" hidden>
        <span class="sr-only">Mostrar u ocultar terminal</span><span aria-hidden="true">▾</span>
      </button>
    </div>
    <div class="term-cuerpo" data-term-cuerpo>
      <div class="term-salida mono" data-term-salida aria-live="polite">
        <p><span class="ok">juanma</span> v2026 · escribí <span class="cmd">ayuda</span> para ver qué podés hacer.</p>
      </div>
      <form class="term-linea mono" data-term-form hidden>
        <label for="term-input"><span class="prompt">juanma@belgrano:~$</span><span class="sr-only"> Comando</span></label>
        <input id="term-input" name="cmd" type="text" autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="send" />
      </form>
    </div>
  </section>

  <footer class="estado mono">
    <span class="disp"><span class="led" aria-hidden="true"></span> disponible</span>
    <span>respondo en {sitio.respuesta}</span>
    <span class="der primero">General Belgrano · 100% remoto</span>
    <span class="der">es-AR</span>
    <span class="der">© {new Date().getFullYear()}</span>
  </footer>
</div>

<script>
  import { iniciarEditor } from "./editor";
  iniciarEditor();
</script>

<style>
  /* ---------- Sin JS / base: documento normal ---------- */
  .ide { min-height: 100dvh; display: flex; flex-direction: column; }

  .barra-titulo {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    height: var(--alto-titulo);
    padding: 0 var(--space-4);
    background: var(--ide-panel);
    border-bottom: 1px solid var(--ide-borde);
  }
  .marca { display: inline-flex; align-items: center; }
  .ruta {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-align: center;
    color: var(--ide-texto-2);
    font-size: var(--fs-ui);
  }
  .ruta span { color: var(--crema); }
  .escribime {
    display: inline-flex;
    align-items: center;
    height: 2rem;
    padding: 0 var(--space-4);
    border-radius: var(--radius-box);
    border: 1px solid var(--lima);
    color: var(--lima);
    font-size: var(--fs-ui);
    font-weight: 600;
    text-decoration: none;
  }
  .escribime:hover { background: var(--lima); color: var(--pino); }

  .btn-archivos {
    height: 2rem;
    padding: 0 var(--space-3);
    background: none;
    border: 1px solid var(--ide-borde);
    border-radius: var(--radius-box);
    font-size: var(--fs-ui);
  }

  .explorador {
    background: var(--ide-panel);
    border-bottom: 1px solid var(--ide-borde);
    padding: var(--space-4) 0;
    font-size: var(--fs-ui);
  }
  .exp-tit {
    padding: 0 var(--space-4) var(--space-2);
    text-transform: uppercase;
    letter-spacing: .12em;
    font-size: var(--fs-micro);
    color: var(--ide-texto-2);
  }
  .arbol, .arbol ul { list-style: none; padding: 0; }
  .arbol ul { padding-left: var(--space-4); }
  .arbol a, .arbol summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2rem;
    padding: 0 var(--space-4);
    text-decoration: none;
    color: var(--ide-texto-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    cursor: pointer;
  }
  .arbol summary { list-style: none; color: var(--crema); }
  .arbol summary::-webkit-details-marker { display: none; }
  .flecha { display: inline-block; transition: transform .15s ease; color: var(--musgo); }
  details[open] > summary .flecha { transform: rotate(90deg); }
  .arbol a:hover, .arbol summary:hover { background: var(--ide-linea); color: var(--crema); }
  .arbol a[aria-current="page"] {
    background: var(--ide-linea);
    color: var(--crema);
    box-shadow: inset 2px 0 0 var(--lima);
  }
  .ext {
    min-width: 3ch;
    font-size: var(--fs-micro);
    font-weight: 600;
    text-transform: uppercase;
    color: var(--salvia);
  }
  a[data-ext="ts"] .ext, a[data-ext="tsx"] .ext { color: var(--lima); }
  a[data-ext="sh"] .ext { color: var(--crema); }
  .nom { overflow: hidden; text-overflow: ellipsis; }
  .punto { margin-left: auto; color: var(--salvia); font-size: var(--fs-micro); }
  .exp-pie {
    margin-top: var(--space-6);
    padding: var(--space-4) var(--space-4) 0;
    border-top: 1px solid var(--ide-borde);
    color: var(--ide-texto-2);
    font-size: var(--fs-micro);
    line-height: 1.6;
  }

  .editor { flex: 1; min-width: 0; display: flex; flex-direction: column; }

  .terminal { display: none; }
  :global(.js) .terminal { display: block; }
  .terminal {
    background: var(--ide-panel);
    border-top: 1px solid var(--ide-borde);
    font-size: var(--fs-ui);
  }
  .term-barra {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: 0 var(--space-4);
    height: 2rem;
    border-bottom: 1px solid var(--ide-borde);
    text-transform: uppercase;
    letter-spacing: .1em;
    font-size: var(--fs-micro);
    color: var(--ide-texto-2);
  }
  .term-barra > span:first-child { color: var(--crema); box-shadow: inset 0 -1px 0 var(--lima); line-height: 2rem; }
  .term-ayuda { text-transform: none; letter-spacing: 0; }
  .term-ayuda code { font-size: inherit; color: var(--lima); }
  .term-toggle {
    margin-left: auto;
    width: 2rem;
    height: 2rem;
    background: none;
    border: 0;
    color: var(--crema);
  }
  .term-cuerpo { padding: var(--space-3) var(--space-4); }
  .term-salida {
    display: grid;
    gap: var(--space-1);
    font-size: var(--fs-ui);
    line-height: 1.6;
    color: var(--ide-texto-2);
    max-height: 9rem;
    overflow-y: auto;
  }
  .term-salida :global(.ok) { color: var(--lima); }
  .term-salida :global(.cmd) { color: var(--crema); }
  .term-salida :global(.eco) { color: var(--crema); }
  .term-salida :global(a) { color: var(--lima); }
  .term-linea { align-items: center; gap: var(--space-2); margin-top: var(--space-1); }
  .prompt { color: var(--lima); white-space: nowrap; font-size: var(--fs-ui); }
  .term-linea input {
    flex: 1;
    min-width: 0;
    min-height: 2rem;
    background: none;
    border: 0;
    outline: none;
    color: var(--crema);
    font-size: max(16px, var(--fs-ui)); /* 16px evita el zoom de iOS al enfocar */
    caret-color: var(--lima);
  }
  .term-linea:focus-within { box-shadow: inset 0 -2px 0 var(--lima); }

  .estado {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--alto-estado);
    padding: 0 var(--space-4);
    background: var(--musgo);
    color: var(--blanco);
    font-size: var(--fs-micro);
    white-space: nowrap;
    overflow: hidden;
  }
  .disp { display: inline-flex; align-items: center; gap: var(--space-2); }
  .led { width: .5rem; height: .5rem; border-radius: 50%; background: var(--lima); }
  .primero { margin-left: auto; }

  /* ---------- Con JS ---------- */
  :global(.js) .terminal.plegada .term-cuerpo { display: none; }
  :global(.js) .terminal.plegada .term-toggle span[aria-hidden] { display: inline-block; transform: rotate(180deg); }
  @media (min-width: 52rem) { .btn-archivos { display: none; } }
  :global(.js) .pestanas { display: flex; }
  :global(.js) .term-linea { display: flex; }
  :global(.js) .paneles :global(.panel:not(.activo)) { display: none; }
  :global(.js) .paneles :global(.panel) { border-bottom: 0; }

  .pestanas {
    overflow-x: auto;
    scrollbar-width: none;
    background: var(--ide-panel);
    border-bottom: 1px solid var(--ide-borde);
    font-size: var(--fs-ui);
  }
  .pestanas :global(.pestana) {
    display: flex;
    align-items: center;
    flex: none;
    border-right: 1px solid var(--ide-borde);
    color: var(--ide-texto-2);
  }
  .pestanas :global(.pestana:has([aria-current])) {
    background: var(--ide-fondo);
    color: var(--crema);
    box-shadow: inset 0 2px 0 var(--lima);
  }
  .pestanas :global(.pestana button) {
    height: 2.25rem;
    background: none;
    border: 0;
    color: inherit;
    font-size: inherit;
  }
  .pestanas :global(.p-abrir) { padding: 0 var(--space-2) 0 var(--space-4); }
  .pestanas :global(.p-cerrar) { width: 2rem; opacity: .6; }
  .pestanas :global(.p-cerrar:hover) { opacity: 1; color: var(--lima); }

  /* Escritorio: el editor ocupa la pantalla y cada zona scrollea sola */
  @media (min-width: 52rem) {
    :global(.js) .ide {
      height: 100dvh;
      display: grid;
      grid-template-columns: var(--ancho-explorador) 1fr;
      grid-template-rows: var(--alto-titulo) 1fr auto var(--alto-estado);
      grid-template-areas:
        "titulo titulo"
        "explorador editor"
        "explorador terminal"
        "estado estado";
    }
    :global(.js) .barra-titulo { grid-area: titulo; position: static; }
    :global(.js) .explorador {
      grid-area: explorador;
      overflow-y: auto;
      border-bottom: 0;
      border-right: 1px solid var(--ide-borde);
      display: flex;
      flex-direction: column;
    }
    :global(.js) .exp-pie { margin-top: auto; }
    :global(.js) .editor { grid-area: editor; min-height: 0; }
    :global(.js) .paneles { flex: 1; overflow-y: auto; }
    :global(.js) .terminal { grid-area: terminal; }
    :global(.js) .estado { grid-area: estado; }
  }

  /* Celular: explorador como cajón, terminal plegable */
  @media (max-width: 51.99rem) {
    .ruta { visibility: hidden; }
    .der { display: none; }
    :global(.js) .btn-archivos { display: inline-flex; align-items: center; gap: var(--space-2); }
    :global(.js) .explorador {
      position: fixed;
      inset: var(--alto-titulo) auto 0 0;
      width: min(85vw, 20rem);
      z-index: 40;
      overflow-y: auto;
      border-right: 1px solid var(--ide-borde);
      transform: translateX(-100%);
      transition: transform .2s ease;
      visibility: hidden;
    }
    :global(.js) .explorador.abierto {
      transform: none;
      visibility: visible;
      box-shadow: 0 0 0 100vmax color-mix(in srgb, var(--pino) 70%, transparent);
    }
    :global(.js) .term-toggle { display: inline-block; }
    :global(.js) .terminal { position: sticky; bottom: 0; z-index: 20; }
    .term-salida { max-height: 7rem; }
    /* Áreas táctiles */
    .escribime, .btn-archivos, .term-toggle { height: var(--tap-min); min-width: var(--tap-min); }
    .arbol a, .arbol summary { min-height: var(--tap-min); }
    .pestanas :global(.pestana button) { height: var(--tap-min); }
    .pestanas :global(.p-cerrar) { width: var(--tap-min); }
    .barra-titulo { height: calc(var(--tap-min) + var(--space-2)); }
    :global(.js) .explorador { inset: calc(var(--tap-min) + var(--space-2)) auto 0 0; }
  }
</style>
