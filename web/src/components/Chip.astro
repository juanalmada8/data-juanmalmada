---
interface Props { as?: "li" | "span" }
const { as: Tag = "span" } = Astro.props;
---
<Tag class="chip"><slot /></Tag>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: var(--space-1) var(--space-4);
    border: 1px solid var(--texto-2, currentColor);
    border-radius: var(--radius-pill);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    letter-spacing: .04em;
    color: var(--texto);
  }
</style>
