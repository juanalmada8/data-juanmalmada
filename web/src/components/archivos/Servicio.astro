---
import Codigo from "../ide/Codigo.astro";
interface Props {
  id: string;
  titulo: string;
  problema: string;
  codigo: string;
  lang: string;
  archivo: string;
  armo: string;
  ahorra: string;
}
const p = Astro.props;
---
<h2 id={`${p.id}-titulo`}>{p.titulo}</h2>
<p class="cita">{p.problema}</p>
<Codigo codigo={p.codigo} lang={p.lang} />
<dl class="criollo">
  <div>
    <dt>qué armo</dt>
    <dd>{p.armo}</dd>
  </div>
  <div>
    <dt>qué te ahorra</dt>
    <dd>{p.ahorra}</dd>
  </div>
</dl>
