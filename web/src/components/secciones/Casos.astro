---
// Casos reales en pestañas (patrón ARIA de tabs). Cada caso es un archivo de src/content/casos/: sumar uno no toca este componente.
// En escritorio la captura se ve en el escenario fijo; en el celular, dentro de cada caso. Sin JavaScript se ven apilados.
// Spec: openspec/changes/landing-una-pagina/specs/casos.
import Captura from "../Captura.astro";
import { cargarCasos } from "../../lib/casos";

const casos = await cargarCasos();
---
{casos.length > 0 && (
<section id="casos" class="seccion-lectura" aria-labelledby="casos-titulo">
  <div class="interior" data-casos>
    <h2 id="casos-titulo" data-aparece>Un consultorio y una plataforma.</h2>

    <div class="pestanas" role="tablist" aria-label="Casos" data-pestanas>
      {casos.map((c, i) => (
        <button
          type="button"
          role="tab"
          class="pestana"
          id={`tab-${c.id}`}
          aria-controls={`caso-${c.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-caso={c.id}
          translate="no"
        >{c.data.nombre}</button>
      ))}
    </div>

    <div class="casos" data-aparece>
      {casos.map((c, i) => (
        <div
          class:list={["caso", { activo: i === 0 }]}
          id={`caso-${c.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${c.id}`}
        >
          <h3 class="sr-only" translate="no">{c.data.nombre}</h3>
          <p class="resumen">{c.data.resumen}</p>
          <ul class="bullets">
            {c.data.bullets.map((b) => <li>{b}</li>)}
          </ul>
          <a class="link" href={c.data.url} target="_blank" rel="noopener noreferrer">
            Ver {new URL(c.data.url).hostname} <span aria-hidden="true">↗</span><span class="sr-only"> (se abre en otra pestaña)</span>
          </a>
          <div class="en-lectura">
            {c.data.capturas.length > 0
              ? c.data.capturas.map((cap) => <Captura caso={c.data.nombre} captura={cap} />)
              : <Captura caso={c.data.nombre} marco="ventana" />}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
)}

<script>
  // Pestañas: un clic cambia de caso; flechas, Home y End con el teclado. También cambia la captura del escenario.
  const raiz = document.querySelector<HTMLElement>("[data-casos]");
  if (raiz) {
    const tabs = [...raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const paneles = [...raiz.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const capturas = [...document.querySelectorAll<HTMLElement>("[data-caso-captura]")];
    const activar = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
      });
      paneles.forEach((p) => p.classList.toggle("activo", p.id === tab.getAttribute("aria-controls")));
      capturas.forEach((c) => c.classList.toggle("activo", c.dataset.casoCaptura === tab.dataset.caso));
    };
    const elegirDesdeUsuario = (tab: HTMLButtonElement) => {
      activar(tab);
      history.replaceState(null, "", `#caso-${tab.dataset.caso}`); // la URL refleja el caso: se puede compartir
    };
    const inicial = tabs.find((t) => `#caso-${t.dataset.caso}` === location.hash);
    if (inicial) activar(inicial);
    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => elegirDesdeUsuario(tab));
      tab.addEventListener("keydown", (e) => {
        const mov = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
        const destino = e.key === "Home" ? 0 : e.key === "End" ? tabs.length - 1 : mov ? (i + mov + tabs.length) % tabs.length : -1;
        if (destino < 0) return;
        e.preventDefault();
        tabs[destino].focus();
        elegirDesdeUsuario(tabs[destino]);
      });
    });
  }
</script>

<style>
  /* Pestañas de texto: la activa va subrayada, sin pastillas ni cajas */
  .pestanas { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-6); margin-top: var(--space-8); }
  .pestana {
    min-height: var(--tap-min);
    padding: 0;
    border: 0;
    border-bottom: var(--grosor-nav) solid transparent;
    background: transparent;
    color: var(--pino);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    font-weight: 700;
    cursor: pointer;
  }
  .pestana:hover { border-bottom-color: var(--salvia); }
  .pestana[aria-selected="true"] { border-bottom-color: var(--pino); }

  .caso { display: grid; gap: var(--space-4); justify-items: start; margin-top: var(--space-6); }
  .resumen { font-size: var(--fs-lead); line-height: 1.35; max-width: 32ch; }
  .bullets { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  .bullets li { position: relative; padding-left: var(--space-6); }
  .bullets li::before { content: ""; position: absolute; left: 0; top: .6em; width: .75rem; height: 2px; background: var(--musgo); }
  .en-lectura { width: 100%; max-width: var(--ancho-escenario); margin-top: var(--space-4); }

  /* Sin JavaScript: todos apilados, sin pestañas. Con JavaScript: uno por vez. */
  :global(html:not(.js)) .pestanas { display: none; }
  :global(html:not(.js)) .caso + .caso { margin-top: var(--space-12); }
  :global(html.js) .caso:not(.activo) { display: none; }

  /* Escritorio: la captura vive en el escenario */
  @media (min-width: 64rem) { .en-lectura { display: none; } }
</style>
