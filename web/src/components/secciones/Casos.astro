---
// «Cosas que armé»: casos reales como fichas editoriales, sin caja: el nombre, la historia en dos o tres partes cortas (la última, la
// solución, destacada) y la captura. Los dos lado a lado para verlos de un vistazo. Cada caso es un archivo de src/content/casos/.
// Spec: openspec/changes/landing-una-pagina/specs/casos.
import Captura from "../Captura.astro";
import { cargarCasos } from "../../lib/casos";
import { urlWhatsApp } from "../../lib/whatsapp";
import { proyectos } from "../../data/proyectos";

const casos = await cargarCasos();
---
{casos.length > 0 && (
<section id="casos" class="seccion-ancha tema-crema" aria-labelledby="casos-titulo">
  <div class="marco">
    <div class="cabecera-casos">
      <div>
        <h2 id="casos-titulo" data-aparece>Cosas que <em>armé</em>.</h2>
        <p class="intro" data-aparece>Casos reales, de un negocio chico a una plataforma para empresas. Lo tuyo puede ser otra cosa.</p>
      </div>
      <p class="proximo" data-aparece>
        ¿Tu caso puede ser el próximo?
        <a class="link" href={urlWhatsApp("Hola Juanma, quiero armar algo")} target="_blank" rel="noopener noreferrer">Contame<span class="sr-only"> (se abre WhatsApp en otra pestaña)</span></a>
      </p>
    </div>

    <ul class="casos">
      {casos.map((c) => (
        <li class="caso" data-aparece>
          <div class="encabezado">
            <h3 translate="no">{c.data.nombre}</h3>
            <a class="link" href={c.data.url} target="_blank" rel="noopener noreferrer">
              Ver {new URL(c.data.url).hostname} <span aria-hidden="true">↗</span><span class="sr-only"> (se abre en otra pestaña)</span>
            </a>
          </div>
          <dl class="partes">
            {c.data.partes.map((p, i) => (
              <div class:list={["parte", { hoy: i === c.data.partes.length - 1 }]}>
                <dt>{p.titulo}</dt>
                <dd>{p.texto}</dd>
              </div>
            ))}
          </dl>
          <div class="captura-caso">
            {c.data.capturas.length > 0
              ? c.data.capturas.map((cap) => <Captura caso={c.data.nombre} captura={cap} />)
              : <Captura caso={c.data.nombre} marco="ventana" />}
          </div>
        </li>
      ))}
    </ul>

    {proyectos.length > 0 && (
      <div class="otras" data-aparece>
        <h3>Y otras cosas que armé</h3>
        <ul class="lineas">
          {proyectos.map((p) => (
            <li class="linea">
              {p.destacado && p.linea.includes(p.destacado)
                ? <>{p.linea.split(p.destacado)[0]}<strong>{p.destacado}</strong>{p.linea.split(p.destacado).slice(1).join(p.destacado)}</>
                : p.linea}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>
)}

<style>
  .intro { margin-top: var(--space-3); max-width: 52ch; font-weight: 500; }
  .casos { list-style: none; padding: 0; display: grid; gap: var(--space-6) var(--space-12); margin-top: var(--space-4); }
  .caso { display: grid; gap: var(--space-3); align-content: start; justify-items: start; }
  .encabezado { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-1) var(--space-4); }
  .caso h3 { font-size: var(--fs-tarjeta); line-height: 1; letter-spacing: -.02em; }
  .cabecera-casos { display: grid; gap: var(--space-3); }
  @media (min-width: 64rem) { .cabecera-casos { grid-template-columns: 1fr auto; align-items: end; } }
  .partes { display: grid; gap: var(--space-3); }
  .parte dt { font-weight: 800; font-size: var(--fs-small); }
  .parte dd { max-width: 46ch; font-size: var(--fs-small); line-height: 1.45; }
  /* La última parte (lo que se armó o cómo quedó) se distingue: va sobre un fondo propio, sin borde */
  .hoy { padding: var(--space-2) var(--space-4); border-radius: var(--radius-box); background: var(--papel); }
  .link { display: inline-flex; align-items: center; min-height: var(--tap-min); font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: var(--space-1); }
  .link:hover { color: inherit; text-decoration-thickness: 4px; }
  .captura-caso { width: 100%; max-width: 18rem; }
  .proximo { font-weight: 700; display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); }

  .otras { margin-top: var(--space-8); display: grid; gap: var(--space-4); }
  .otras h3 { font-size: var(--fs-tarjeta); }
  .lineas { list-style: none; padding: 0; display: grid; gap: var(--space-3); }
  .linea { padding: var(--space-4) var(--space-6); border-radius: var(--radius-tarjeta); background: var(--papel); color: var(--pino); }
  @media (min-width: 40rem) { .lineas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .lineas { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 48rem) { .casos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
