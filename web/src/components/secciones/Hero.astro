---
// Hero pino pegado a la barra (como thoughtbot): un titular con lo que gana el cliente («más simple y bajo control»), bajada con
// escenas concretas, CTA lima y enlaces directos, y una línea de confianza; a la derecha, un collage con dos capturas reales (la prueba
// va arriba de todo, no la firma). El lema del manual va en el pie. Spec: openspec/changes/landing-una-pagina/specs/{landing,selector-hero}.
import Captura from "../Captura.astro";
import { sitio, contacto } from "../../data/sitio";
import oralEscritorio from "../../assets/casos/oral-escritorio.png";
import staffyCelu from "../../assets/casos/staffy-celu.png";

const experiencia = sitio.experiencia.charAt(0).toUpperCase() + sitio.experiencia.slice(1); // «Más de 7 años» (con espacio de no separación)
---
<section id="hero" class="hero tema-pino" aria-labelledby="hero-titulo">
  <div class="marco interior">
    <h1 id="hero-titulo"><span class="r">Tu negocio, más simple</span> <span class="r">y <em>bajo control</em>.</span></h1>

    <div class="pie-hero">
      <div class="accion">
        <p class="lead">Armo soluciones a medida: sistemas de gestión, bots con inteligencia artificial, webs y tableros con tus datos. Para que ahorres tiempo, trabajes más cómodo y sepas en todo momento qué pasa en tu negocio.</p>
        <a class="boton lima flecha" href="#contacto">Charlemos</a>
        <p class="directo">
          <span>O escribime directo:</span>
          <a href={contacto.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp<span class="sr-only"> (se abre en otra pestaña)</span></a>
          <a href={contacto.instagram} target="_blank" rel="noopener noreferrer">Instagram<span class="sr-only"> (se abre en otra pestaña)</span></a>
          <a href={`mailto:${contacto.mail}`}>Mail</a>
        </p>
        <p class="confianza">{experiencia} armando sistemas · Trabajo en forma remota en todo el país</p>
      </div>

      <div class="prueba">
        <div class="collage"> <!-- alt vacío a propósito: el pie de abajo ya nombra los dos casos y las mismas capturas, con su descripción, están en «Cosas que armé» -->
          <Captura
            caso="Oral Odontología Familiar"
            captura={{ src: oralEscritorio, alt: "", marco: "ventana" }}
            lazy={false}
            sizes="(min-width: 64rem) 30rem, 90vw"
          />
          <div class="celu-sup">
            <Captura
              caso="Staffy"
              captura={{ src: staffyCelu, alt: "", marco: "celu" }}
              lazy={false}
              sizes="8rem"
            />
          </div>
        </div>
        <p class="pie-collage"><span translate="no">Oral Odontología Familiar</span> y <span translate="no">Staffy</span>, <a class="link" href="#casos">dos de los sistemas que armé</a>.</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* El hero llena la primera pantalla (alto de la ventana menos la barra): así la franja de abajo no asoma cortada */
  .hero { padding: var(--space-6) 0 var(--space-12); min-height: calc(100svh - var(--alto-barra)); display: grid; align-content: center; }
  .interior { display: grid; gap: var(--space-8); }
  h1 em { color: var(--salvia); } /* la lima queda para los botones y la pastilla: el itálico del titular va en salvia */
  .pie-hero { display: grid; gap: var(--space-8); }
  .accion { display: grid; gap: var(--space-4); justify-items: start; align-content: start; max-width: var(--ancho-accion); }
  .accion .boton { white-space: nowrap; }
  .lead { max-width: 40ch; }
  .directo { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-4); font-size: var(--fs-small); }
  .directo a { display: inline-flex; align-items: center; min-height: var(--tap-min); min-width: var(--tap-min); font-weight: 700; text-underline-offset: .2em; }
  .confianza { font-size: var(--fs-small); color: var(--salvia); max-width: 36ch; }

  /* Collage de dos capturas reales: la de escritorio en marco ventana y la del celu encima, abajo a la derecha. Sin caja alrededor. */
  .prueba { display: grid; gap: var(--space-3); align-content: start; max-width: 36rem; }
  .collage { position: relative; margin-bottom: var(--space-12); }
  /* El celu va abajo a la derecha: no tapa el titular de la captura de Oral y cubre la franja con la dirección del consultorio */
  .celu-sup { position: absolute; right: 9%; bottom: calc(var(--space-12) * -1); width: 22%; }
  .collage :global(.captura) { box-shadow: 0 0 0 1px color-mix(in srgb, var(--crema) 18%, transparent); }
  .pie-collage { font-size: var(--fs-small); color: var(--salvia); }
  .pie-collage .link { color: var(--crema); }

  h1 .r { display: block; } /* dos renglones fijos: «Tu negocio, más simple» / «y bajo control.» */
  /* Ventanas bajas: menos aire para que el hero entre en la pantalla */
  @media (min-width: 48rem) and (max-height: 800px) { .hero { padding-bottom: var(--space-6); } }
  @media (min-width: 48rem) and (max-height: 760px) {
    .interior, .pie-hero { gap: var(--space-4); }
    .collage { margin-bottom: var(--space-8); }
    .celu-sup { bottom: calc(var(--space-8) * -1); }
  }
  /* Desde 1024 px la acción y la prueba van lado a lado; antes, la prueba baja para que el CTA no se parta */
  @media (min-width: 64rem) {
    .pie-hero { grid-template-columns: minmax(0, 1fr) minmax(0, var(--ancho-marcos)); align-items: start; gap: var(--space-12); }
    /* La prueba se achica con la altura de la ventana (el ancho útil sale del alto menos lo que ocupan titular, aire y pie): el hero entra siempre */
    .prueba { max-width: min(100%, calc((100svh - 24rem) * 1.5)); justify-self: end; width: 100%; }
  }
</style>
