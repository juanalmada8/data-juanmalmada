---
import Logo from "../Logo.astro";
import Etiqueta from "../Etiqueta.astro";
import Boton from "../Boton.astro";
import Chip from "../Chip.astro";
import PatronM from "../PatronM.astro";
import { contacto } from "../../data/sitio";
---
<section class="hero tema-pino" aria-labelledby="hero-titulo">
  <div class="contenedor grilla">
    <div class="texto">
      <Etiqueta class="minus">hola_mundo()</Etiqueta>
      <h1 id="hero-titulo">Un solo proveedor, <em>todo el&nbsp;sistema</em>.</h1>
      <p class="lead">
        Webs, apps y datos que trabajan por vos. Lo que hoy hacés a mano, que lo haga el sistema.
      </p>
      <div class="acciones">
        <Boton href={contacto.whatsapp} externo>Escribime</Boton>
        <Boton href="#proyectos" variante="secundario">Ver proyectos</Boton>
      </div>
      <ul class="chips" aria-label="Lo que armo">
        <Chip as="li">web y apps</Chip>
        <Chip as="li">turnos y gestión</Chip>
        <Chip as="li">datos</Chip>
        <Chip as="li">nube</Chip>
      </ul>
    </div>
    <div class="logo-hero">
      <Logo variante="cursor" ancho="100%" decorativo />
    </div>
  </div>
  <PatronM filas={2} lima={[[0, 2], [1, 6], [0, 11]]} />
</section>

<style>
  .hero { padding-top: clamp(var(--space-8), 6vw, var(--space-16)); }
  .grilla {
    display: grid;
    gap: var(--space-8);
    padding-bottom: clamp(var(--space-12), 7vw, var(--space-24));
  }
  .texto { display: grid; gap: var(--space-6); justify-items: start; }
  .lead { color: var(--crema); }
  .acciones { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .logo-hero { width: min(100%, 22rem); }

  @media (max-width: 30rem) {
    .texto { gap: var(--space-4); }
    .chips { display: none; }
    .logo-hero { width: 12rem; }
  }

  @media (min-width: 60rem) {
    .grilla {
      grid-template-columns: 1.25fr 1fr;
      align-items: center;
      gap: var(--space-16);
    }
    .logo-hero { width: 100%; justify-self: end; }
  }
</style>
