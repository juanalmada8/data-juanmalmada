---
// Hero oscuro (como la portada del manual): titular, bajada, selector «¿Qué necesitás?», CTA, y a la derecha el logo grande
// con el cursor y la vista previa. El tema elegido cambia el tono del fondo y la bajada; el titular no cambia.
// Spec: openspec/changes/landing-una-pagina/specs/{landing,selector-hero}.
// Sin JavaScript se leen los 6 temas como lista; con JavaScript son chips y una vista previa por vez.
import Captura from "../Captura.astro";
import Logo from "../Logo.astro";
import Pipeline from "../Pipeline.astro";
import PatronDatos from "../PatronDatos.astro";
import PatronM from "../PatronM.astro";
import { temas, temaInicial } from "../../data/temas";
import { cargarCasos } from "../../lib/casos";
import { urlWhatsApp } from "../../lib/whatsapp";

const casos = await cargarCasos();
const caso = (id: string) => casos.find((c) => c.id === id);
const inicial = temas.find((t) => t.id === temaInicial)!;
---
<section id="hero" class="hero tema-pino" aria-labelledby="hero-titulo" style={`--mezcla:${inicial.mezcla}%`}>
  <div class="contenedor grilla">
    <div class="h-texto">
      <p class="etiqueta-codigo mono"><span>hola_mundo()</span></p>
      <h1 id="hero-titulo"><span class="r">Todo el sistema,</span> <em class="r">un solo&nbsp;proveedor.</em></h1>
      <p class="lead" data-bajada>{inicial.bajada}</p>
    </div>

    <div class="h-selector" data-selector>
      <p class="rotulo" id="sel-etiqueta">¿Qué necesitás?</p>
      <div class="chips" role="radiogroup" aria-labelledby="sel-etiqueta">
        {temas.map((t) => (
          <button
            type="button"
            class="chip"
            role="radio"
            aria-checked={t.id === temaInicial ? "true" : "false"}
            tabindex={t.id === temaInicial ? 0 : -1}
            data-tema={t.id}
            data-wa={urlWhatsApp(t.mensaje)}
            data-bajada={t.bajada}
            data-mezcla={t.mezcla}
          >{t.chip}</button>
        ))}
      </div>
    </div>

    <div class="h-cta">
      <a class="boton lima flecha" href="#contacto">Contame tu idea</a>
    </div>

    <div class="derecha">
      <Logo variante="cursor" ancho="min(100%, 22rem)" class="logo-hero" decorativo />
      <div class="vistas tema-crema" aria-live="polite">
        {temas.map((t) => (
          <div class:list={["vista", { activo: t.id === temaInicial }]} data-vista={t.id} role="group" aria-label={t.chip}>
            <p class="nombre-tema rotulo">{t.chip}</p>
            <div class="visual">
              {t.vista.tipo === "capturas" && (
                <div class="caps">
                  {t.vista.casos.map((id) => {
                    const c = caso(id);
                    return c && <Captura caso={c.data.nombre} captura={c.data.capturas[0]} marco="ventana" />;
                  })}
                </div>
              )}
              {t.vista.tipo === "pipeline" && (
                <Pipeline pasos={["planillas", "se ordenan", "un solo lugar"]} />
              )}
              {t.vista.tipo === "datos" && <PatronDatos columnas={10} filas={3} class="datos" />}
            </div>
            {t.vista.tipo === "invitacion" ? (
              <>
                <p class="frase grande">{t.frase}</p>
                <a class="boton flecha" href="#contacto">Contame tu idea</a>
              </>
            ) : (
              <>
                <p class="ejemplo">{t.ejemplo}</p>
                <p class="frase">{t.frase}</p>
              </>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
  <PatronM tono="pino" lima={[[0, 9]]} class="banda" />
</section>

<script>
  // Selector: radiogroup con flechas. Elegir un tema cambia la vista previa, el tono del fondo y la bajada del hero.
  // El tema que ELIGE el visitante (no el inicial) viaja al mensaje de WhatsApp.
  const hero = document.getElementById("hero");
  const grupo = document.querySelector<HTMLElement>("[data-selector] .chips");
  if (hero && grupo) {
    const chips = [...grupo.querySelectorAll<HTMLButtonElement>('[role="radio"]')];
    const vistas = [...document.querySelectorAll<HTMLElement>("[data-vista]")];
    const bajada = hero.querySelector<HTMLElement>("[data-bajada]");
    const enlaces = () => [...document.querySelectorAll<HTMLAnchorElement>("[data-wa-tema]")];

    const elegir = (chip: HTMLButtonElement, desdeVisitante: boolean) => {
      chips.forEach((c) => {
        const activo = c === chip;
        c.setAttribute("aria-checked", String(activo));
        c.tabIndex = activo ? 0 : -1;
      });
      vistas.forEach((v) => v.classList.toggle("activo", v.dataset.vista === chip.dataset.tema));
      hero.style.setProperty("--mezcla", `${chip.dataset.mezcla}%`);
      if (bajada) bajada.textContent = chip.dataset.bajada!;
      if (desdeVisitante) enlaces().forEach((a) => (a.href = chip.dataset.wa!));
    };

    chips.forEach((chip, i) => {
      chip.addEventListener("click", () => elegir(chip, true));
      chip.addEventListener("keydown", (e) => {
        const salto = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
        const destino = e.key === "Home" ? 0 : e.key === "End" ? chips.length - 1 : salto ? (i + salto + chips.length) % chips.length : -1;
        if (destino < 0) return;
        e.preventDefault();
        chips[destino].focus();
        elegir(chips[destino], true);
      });
    });
  }
</script>

<style>
  .hero {
    padding-top: var(--space-8);
    position: relative;
    display: flex;
    flex-direction: column;
    /* El tono del fondo sale de la paleta: pino con un poco de musgo, según el tema (--mezcla: 0–40 %) */
    background-color: color-mix(in srgb, var(--musgo) var(--mezcla, 0%), var(--pino));
  }
  .hero :global(.banda) { margin-top: auto; background: transparent; }
  .grilla { display: grid; gap: var(--space-6); padding-bottom: clamp(var(--space-8), 6vw, var(--space-16)); }
  .h-texto { display: grid; gap: var(--space-4); justify-items: start; }
  /* Dos renglones fijos: «Todo el sistema,» / «un solo proveedor.» */
  h1 .r { display: block; }
  h1 { font-size: clamp(2.5rem, 1.3rem + 5vw, 4.5rem); } /* hasta 72 px: el techo de la lámina del manual */
  /* El alto mínimo evita que los chips se muevan cuando la bajada cambia de largo */
  .lead { max-width: 36ch; min-height: calc(1.45em * 3); }

  /* `hola_mundo()`: en el manual es código, en minúsculas y sobre una pastilla lima */
  .etiqueta-codigo span {
    display: inline-block;
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--lima);
    color: var(--pino);
    font-size: var(--fs-small);
    font-weight: 500;
    transform: rotate(-2deg);
  }

  /* Chips sobre fondo oscuro: contorno claro; el elegido, lima */
  .h-selector { display: grid; gap: var(--space-2); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .chip {
    min-height: var(--tap-min);
    padding: 0 var(--space-4);
    border: 2px solid var(--salvia);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--crema);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 500;
    cursor: pointer;
    transition: background-color .15s ease, color .15s ease, border-color .15s ease, transform .1s ease;
  }
  .chip:hover { border-color: var(--lima); }
  .chip:active { transform: scale(.96); }
  .chip[aria-checked="true"] { background: var(--lima); border-color: var(--lima); color: var(--pino); }

  /* Derecha: logo grande (solo escritorio) y la vista previa en una tarjeta crema */
  .derecha { display: grid; gap: var(--space-6); align-content: center; justify-items: start; }
  .derecha :global(.logo-hero) { display: none; }
  .vistas { width: 100%; padding: var(--space-4); border-radius: var(--radius-card); }
  .vista { display: grid; gap: var(--space-3); align-content: start; }
  .nombre-tema { display: none; }
  .visual:empty { display: none; }
  .caps { display: grid; grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr)); gap: var(--space-3); }
  .ejemplo { font-family: var(--font-serif); font-size: var(--fs-h3); line-height: 1.1; }
  .frase.grande { font-family: var(--font-serif); font-size: var(--fs-h3); line-height: 1.15; }
  .vista :global(.datos) { width: 100%; max-height: 7rem; }
  .vista .boton { justify-self: start; }

  /* Sin JavaScript: lista de los 6 temas, sin chips */
  :global(html:not(.js)) .chips { display: none; }
  :global(html:not(.js)) .vista { padding-block: var(--space-4); border-top: var(--borde-suave); }
  :global(html:not(.js)) .nombre-tema { display: block; }
  :global(html.js) .vista:not(.activo) { display: none; }

  /* Movimiento: el fondo cambia de tono y la vista entra suave (solo sin movimiento reducido) */
  @media (prefers-reduced-motion: no-preference) {
    .hero { transition: background-color .5s ease; }
    :global(html.js) .vista.activo { animation: entra .25s ease; }
  }
  @keyframes entra { from { opacity: 0; transform: translateY(var(--space-2)); } }

  @media (max-width: 40rem) {
    .hero { padding-top: var(--space-6); }
    .h-texto { gap: var(--space-3); }
    .lead { font-size: var(--fs-body); }
  }

  @media (min-width: 60rem) {
    .hero { min-height: calc(100svh - var(--alto-barra)); }
    .grilla {
      grid-template-columns: 1.15fr 1fr;
      grid-template-areas: "texto derecha" "selector derecha" "cta derecha";
      column-gap: var(--space-16);
      align-content: center;
      flex: 1;
      padding-block: var(--space-6);
    }
    .h-texto { grid-area: texto; }
    .h-selector { grid-area: selector; }
    .h-cta { grid-area: cta; }
    .derecha { grid-area: derecha; gap: var(--space-6); }
    .derecha :global(.logo-hero) { display: block; }
    .vistas { padding: var(--space-6); }
  }
</style>
