---
// Hero: el titular habla del problema del visitante («lo que hoy hacés a mano»), una bajada, el CTA, el contacto directo y
// stickers inclinados con hechos reales de sitio.ts. El lema del manual («Un solo proveedor, todo el sistema.») va en el pie.
// Spec: openspec/changes/landing-una-pagina/specs/{landing,selector-hero}.
import { sitio, contacto } from "../../data/sitio";

const experiencia = sitio.experiencia[0].toUpperCase() + sitio.experiencia.slice(1); // «Más de 7 años»
---
<section id="hero" class="hero tema-crema" aria-labelledby="hero-titulo">
  <div class="marco interior">
    <h1 id="hero-titulo"><span class="r">Lo que hoy hacés a mano,</span> <span class="r">que lo haga <em>el sistema</em>.</span></h1>

    <div class="pie-hero">
      <div class="accion">
        <p class="lead">Armo sistemas a medida, sea lo que sea que necesite tu negocio.</p>
        <a class="boton lima flecha" href="#contacto">Contame tu idea</a>
        <p class="directo">
          <span>O escribime directo:</span>
          <a href={contacto.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp<span class="sr-only"> (se abre en otra pestaña)</span></a>
          <a href={contacto.instagram} target="_blank" rel="noopener noreferrer">Instagram<span class="sr-only"> (se abre en otra pestaña)</span></a>
          <a href={`mailto:${contacto.mail}`}>Mail</a>
        </p>
      </div>

      <ul class="stickers" aria-label="Datos de Juanma">
        <li class="st a"><span>{experiencia} de oficio</span></li>
        <li class="st b"><span>Respondo en {sitio.respuesta}</span></li>
        <li class="st c"><span>{sitio.base}</span></li>
        <li class="st d" aria-hidden="true"><code translate="no">hola_mundo()</code></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero { padding: var(--space-12) 0 var(--space-16); }
  .interior { display: grid; gap: var(--space-8); }
  /* Dos renglones fijos desde 768 px; en el celular corre libre (hasta 3) */
  .pie-hero { display: grid; gap: var(--space-8); }
  .accion { display: grid; gap: var(--space-4); justify-items: start; align-content: start; max-width: var(--ancho-accion); }
  .accion .boton { white-space: nowrap; }
  .lead { max-width: 30ch; }
  .directo { display: flex; flex-wrap: wrap; align-items: center; column-gap: var(--space-4); font-size: var(--fs-small); }
  .directo a { display: inline-flex; align-items: center; min-height: var(--tap-min); min-width: var(--tap-min); font-weight: 700; text-underline-offset: .2em; }

  /* Stickers: pastillas inclinadas, cada una en un tono de la paleta; solo una lleva lima */
  .stickers { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-4); align-content: start; }
  .st { padding: var(--space-3) var(--space-6); border-radius: var(--radius-pill); font-weight: 700; font-size: var(--fs-small); }
  .a { background: var(--salvia); color: var(--pino); --giro: var(--giro-a); }
  .b { background: var(--pino); color: var(--crema); --giro: var(--giro-b); }
  .c { background: var(--musgo-hondo); color: var(--crema); --giro: var(--giro-c); }
  .d { background: var(--lima); color: var(--pino); --giro: var(--giro-a); font-weight: 500; }
  @media (prefers-reduced-motion: no-preference) {
    .st { transform: rotate(var(--giro)); transition: transform .2s ease; }
    .st:hover { transform: rotate(0deg) scale(1.04); }
  }

  @media (min-width: 48rem) {
    h1 .r { display: block; }
  }
  /* Desde 1024 px la acción y los stickers van lado a lado; antes, los stickers bajan para que el CTA no se parta */
  @media (min-width: 64rem) {
    .hero { padding-top: var(--space-16); }
    .pie-hero { grid-template-columns: 1fr auto; align-items: end; gap: var(--space-12); }
    .stickers { justify-content: flex-end; max-width: var(--ancho-accion); }
  }
</style>
