---
import { contacto } from "../../data/sitio";
const servicios = [
  {
    titulo: "Webs y apps a medida",
    problema: "«Mi web no la actualiza nadie y desde el celular ni se ve.»",
    armo: "Una web o una app rápida, que se usa bien desde el celular y que podés cambiar vos.",
    ahorra: "Depender de alguien para cambiar un precio o un horario.",
  },
  {
    titulo: "Turnos y sistemas de gestión",
    problema: "«Me paso la mañana atendiendo el teléfono para dar turnos.»",
    armo: "Turnos online con recordatorio, o un sistema que ordena tus pedidos o tus trámites en un solo lugar.",
    ahorra: "Las llamadas para dar turnos y los pacientes que se olvidan de venir.",
  },
  {
    titulo: "Dashboards y análisis de datos",
    problema: "«Todos los lunes pierdo la mañana armando el reporte a mano.»",
    armo: "Junto lo que tenés repartido entre planillas y sistemas en un tablero que se actualiza solo, con alertas cuando algo se desvía.",
    ahorra: "Las horas de copiar y pegar, y enterarte tarde de los problemas.",
  },
  {
    titulo: "Nube, infraestructura y arquitectura",
    problema: "«Si se cae el servidor, no sé ni a quién llamar.»",
    armo: "Dejo todo andando en la nube, con respaldos y avisos si algo falla.",
    ahorra: "Que se caiga todo justo cuando más lo necesitás.",
  },
];
---
<section id="que-hago" class="seccion tema-crema" aria-labelledby="que-hago-titulo">
  <div class="contenedor">
    <header class="cabecera" data-aparece>
      <p class="rotulo">01 — Qué hago</p>
      <h2 id="que-hago-titulo">Lo que suele pedir un equipo entero, <span class="acento">lo resuelvo yo</span>.</h2>
    </header>

    <ol class="lista">
      {servicios.map((s, i) => (
        <li class="servicio" data-aparece>
          <span class="num mono" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <div class="cab">
            <h3>{s.titulo}</h3>
            <p class="problema">{s.problema}</p>
          </div>
          <dl class="detalle">
            <div><dt class="rotulo">Qué armo</dt><dd>{s.armo}</dd></div>
            <div><dt class="rotulo">Qué te ahorra</dt><dd>{s.ahorra}</dd></div>
          </dl>
        </li>
      ))}
    </ol>

    <p class="otra" data-aparece>¿Lo tuyo no está en la lista? <a class="link" href={contacto.whatsapp} target="_blank" rel="noopener noreferrer">Contame igual.</a></p>
  </div>
</section>

<style>
  .lista { list-style: none; padding: 0; display: grid; gap: var(--space-4); }
  .servicio {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    background: var(--blanco);
    border: var(--borde-suave);
    border-radius: var(--radius-card);
  }
  .num { font-size: var(--fs-h2); font-weight: 700; line-height: 1; color: var(--musgo); letter-spacing: -.04em; }
  .cab { display: grid; gap: var(--space-2); }
  .problema { font-style: italic; color: var(--musgo); font-size: var(--fs-body); }
  .detalle { display: grid; gap: var(--space-4); }
  .detalle .rotulo { color: var(--musgo); margin-bottom: var(--space-1); }
  dd { margin: 0; }
  .otra { margin-top: var(--space-8); font-size: var(--fs-lead); }

  @media (min-width: 56rem) {
    .servicio {
      grid-template-columns: 5rem 1fr 1.4fr;
      gap: var(--space-8);
      padding: var(--space-8);
      align-items: start;
    }
    .detalle { grid-template-columns: 1fr 1fr; gap: var(--space-6); }
  }
</style>
