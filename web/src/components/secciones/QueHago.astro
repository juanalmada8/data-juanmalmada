---
// «Qué hago»: ejemplos, no un límite. Cada tarjeta: el problema como lo diría el cliente → la solución, en una línea.
// Spec: openspec/changes/landing-una-pagina/specs/servicios.
const ejemplos = [
  {
    titulo: "Webs y apps a medida",
    problema: "¿Tu web no se ve bien en el celular?",
    solucion: "Armo una web o una app a tu medida, pensada para el celular.",
  },
  {
    titulo: "Portales y plataformas con su backend",
    problema: "¿Necesitás que usuarios y empresas trabajen en un mismo sistema?",
    solucion: "Armo el portal y lo que lo sostiene: usuarios, publicaciones, postulaciones y paneles.",
  },
  {
    titulo: "Turnos y reservas online",
    problema: "¿Pasás el día atendiendo el teléfono para dar turnos?",
    solucion: "Tus clientes reservan solos y reciben la confirmación y el recordatorio.",
  },
  {
    titulo: "Sistemas de gestión interna",
    problema: "¿Todo anda en planillas, cuadernos y chats sueltos?",
    solucion: "Un sistema a tu medida donde se ordena el trabajo de todo el equipo.",
  },
  {
    titulo: "Automatización y datos",
    problema: "¿Armás el reporte a mano todos los lunes?",
    solucion: "Conecto tus fuentes y armo reportes y tableros que se actualizan solos.",
  },
];
---
<section id="que-hago" class="seccion tema-crema" aria-labelledby="que-hago-titulo">
  <div class="contenedor">
    <header class="cabecera" data-aparece>
      <p class="rotulo">01 — Qué hago</p>
      <h2 id="que-hago-titulo">Algunas cosas que <em>puedo armar</em>.</h2>
      <p class="lead">Lo que invertís hoy te ahorra tiempo y plata mañana.</p>
    </header>

    <ul class="tarjetas">
      {ejemplos.map((e) => (
        <li class="tarjeta" data-aparece>
          <h3>{e.titulo}</h3>
          <p class="problema">{e.problema}</p>
          <p class="solucion">{e.solucion}</p>
        </li>
      ))}
      <li class="tarjeta cierre" data-aparece>
        <p class="cierre-tit">¿Lo tuyo no está acá?</p>
        <p>Contámelo, seguro se puede armar.</p>
        <a class="boton lima flecha" href="#contacto">Contame tu idea</a>
      </li>
    </ul>
  </div>
</section>

<style>
  .tarjetas { list-style: none; padding: 0; display: grid; gap: var(--space-4); }
  .tarjeta {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-6);
    background: var(--blanco);
    border: var(--borde-suave);
    border-radius: var(--radius-card);
    transition: border-color .2s ease, transform .2s ease;
  }
  .tarjeta:hover { border-color: var(--musgo); transform: translateY(calc(-1 * var(--space-1))); }
  .problema { color: var(--musgo); } /* musgo sobre blanco: 5.1, pasa AA */
  .solucion { color: var(--pino); }
  @media (prefers-reduced-motion: reduce) { .tarjeta:hover { transform: none; } }

  /* Cierre: la puerta abierta a «lo que sea» */
  .cierre { background: var(--pino); border-color: var(--pino); color: var(--crema); }
  .cierre:hover { border-color: var(--pino); }
  .cierre .boton.lima { border-color: var(--lima); }
  .cierre .boton.lima:hover { background: var(--crema); border-color: var(--crema); color: var(--pino); }
  .cierre-tit { font-family: var(--font-serif); font-size: var(--fs-h3); line-height: 1.1; }
  .cierre .boton { justify-self: start; }

  @media (min-width: 40rem) { .tarjetas { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) {
    .tarjetas { grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
    /* Ritmo: una tarjeta ancha y el cierre como banda de ancho completo */
    .tarjeta:nth-child(2) { grid-column: span 2; }
    .tarjeta:nth-child(2) .solucion { max-width: var(--ancho-texto); }
    .cierre { grid-column: 1 / -1; grid-template-columns: 1fr auto; align-items: center; column-gap: var(--space-8); padding-block: var(--space-8); }
    .cierre-tit { grid-column: 1; }
    .cierre p:nth-child(2) { grid-column: 1; }
    .cierre .boton { grid-column: 2; grid-row: 1 / span 2; }
  }
</style>
