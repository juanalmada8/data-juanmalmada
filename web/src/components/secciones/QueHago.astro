---
// «¿Qué te está consumiendo el tiempo?»: seis tarjetas de color, una por problema. Cada una separa el problema (arriba, breve y
// reconocible) de lo que armo para eso (abajo, en un panel propio). Son ejemplos, no un límite. Cada tarjeta abre WhatsApp con el
// problema ya escrito. Sin manifiesto, notas ni líneas sueltas en medio (pedido de Juanma, 2026-11-15). Spec: specs/{servicios,selector-hero}.
import { temas } from "../../data/temas";
import { urlWhatsApp } from "../../lib/whatsapp";
---
<section id="que-hago" class="seccion-ancha tema-crema" aria-labelledby="que-hago-titulo">
  <div class="marco">
    <h2 id="que-hago-titulo" data-aparece>¿Qué te está <em>consumiendo</em> el tiempo?</h2>

    <ul class="tarjetas">
      {temas.map((t, i) => (
        <li class:list={["tarjeta", `f-${t.fondo}`, { oscura: t.fondo === "pino" || t.fondo === "musgo" }]} data-aparece style={`--giro:${["var(--giro-a)", "var(--giro-b)", "var(--giro-c)"][i % 3]}`}>
          <h3 class="problema">{t.titulo}</h3>
          <div class="solucion">
            <p class="nombre">{t.nombre}</p>
            <p class="linea">{t.solucion}</p>
            <a class="ir" href={urlWhatsApp(t.mensaje)} target="_blank" rel="noopener noreferrer">
              Esto me pasa <span aria-hidden="true">→</span><span class="sr-only"> ({t.titulo}; se abre WhatsApp en otra pestaña)</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .tarjetas { list-style: none; padding: 0; display: grid; gap: var(--space-4); margin-top: var(--space-8); }
  .tarjeta {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius-tarjeta);
    overflow: hidden;
  }
  /* Arriba, el problema: breve y reconocible */
  .problema { padding: var(--space-4) var(--space-6) var(--space-3); font-size: var(--fs-tarjeta); line-height: 1.05; letter-spacing: -.02em; }
  /* Abajo, la solución, en un panel propio (un poco más claro en las oscuras y un poco más oscuro en las claras) */
  .solucion { display: grid; gap: var(--space-1); align-content: start; padding: var(--space-3) var(--space-6); }
  .oscura .solucion { background: color-mix(in srgb, var(--crema) 14%, transparent); }
  .f-salvia .solucion, .f-papel .solucion { background: color-mix(in srgb, var(--pino) 9%, transparent); }
  .nombre { font-weight: 800; font-size: var(--fs-body); }
  .linea { font-size: var(--fs-small); max-width: 34ch; }

  /* Fondos: tonos de la paleta del manual; cada par texto/fondo pasa el contraste (test en tests/temas.test.mjs) */
  .f-pino   { background: var(--pino);        color: var(--crema); }
  .f-salvia { background: var(--salvia);      color: var(--pino); }
  .f-papel  { background: var(--papel);       color: var(--pino); }
  .f-musgo  { background: var(--musgo-hondo); color: var(--crema); }

  /* El enlace ocupa toda la tarjeta (un solo destino por tarjeta); el foco se dibuja adentro */
  .ir { margin-top: 0; display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--tap-min); font-weight: 800; text-decoration: none; color: inherit; }
  .ir::before { content: ""; position: absolute; inset: 0; border-radius: var(--radius-tarjeta); }
  .ir:focus-visible { outline: none; }
  /* El anillo va adentro de la tarjeta: lima sobre las oscuras, pino sobre las claras */
  .ir:focus-visible::before { outline: 3px solid var(--lima); outline-offset: calc(var(--space-2) * -1); }
  .f-salvia .ir:focus-visible::before, .f-papel .ir:focus-visible::before { outline-color: var(--pino); }
  .ir span[aria-hidden] { transition: transform .2s ease; }
  .tarjeta:hover .ir span[aria-hidden] { transform: translateX(var(--space-2)); }

  @media (prefers-reduced-motion: no-preference) {
    .tarjeta { transition: transform .25s ease; }
    .tarjeta:hover { transform: translateY(calc(var(--space-1) * -1)); }
  }
  /* Desde 40 rem las tarjetas van en fila: el problema mide siempre dos renglones, para que todas queden parejas */
  @media (min-width: 40rem) { .problema { min-height: calc(var(--fs-tarjeta) * 2.1 + var(--space-4) + var(--space-3)); } }
  @media (min-width: 40rem) { .tarjetas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .tarjetas { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
