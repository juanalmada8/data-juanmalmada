---
// «Cómo trabajo»: cuatro pasos. Sin plazos, precios ni niveles de soporte (no están confirmados).
const pasos = [
  { titulo: "Charla", texto: "Me contás qué necesitás y cómo trabajás hoy." },
  { titulo: "Propuesta", texto: "Te paso la propuesta y el presupuesto." },
  { titulo: "Desarrollo", texto: "Lo construyo y lo vas viendo avanzar." },
  { titulo: "Soporte", texto: "Te lo dejo andando y te acompaño después de la entrega." },
];
---
<section id="como-trabajo" class="seccion tema-crema" aria-labelledby="como-trabajo-titulo">
  <div class="contenedor">
    <header class="cabecera" data-aparece>
      <p class="rotulo">03 — Cómo trabajo</p>
      <h2 id="como-trabajo-titulo">De la charla al soporte, <em>sin vueltas</em>.</h2>
    </header>
    <ol class="pasos">
      {pasos.map((p, i) => (
        <li class="paso" data-aparece>
          <span class="num" aria-hidden="true">{i + 1}</span>
          <h3>{p.titulo}</h3>
          <p>{p.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pasos { list-style: none; padding: 0; display: grid; gap: 0; }
  .paso {
    display: grid;
    grid-template-columns: calc(var(--fs-numeral) * .7) 1fr;
    column-gap: var(--space-4);
    padding: var(--space-4) 0;
    border-top: 2px solid var(--pino);
  }
  .paso:last-child { border-bottom: 2px solid var(--pino); }
  /* Número grande en serif (musgo sobre crema: texto grande, pasa AA) */
  .num { grid-row: span 2; font-family: var(--font-serif); font-size: var(--fs-numeral); line-height: .85; color: var(--musgo); }
  .paso h3 { margin-bottom: var(--space-2); }
  .paso p { color: var(--pino); }

  /* Desde 768 px: una sola fila de cuatro */
  @media (min-width: 48rem) {
    .pasos { grid-template-columns: repeat(4, 1fr); column-gap: var(--space-6); }
    .paso { display: block; border-bottom: 0 !important; padding-top: var(--space-6); }
    .num { display: block; margin-bottom: var(--space-3); }
  }
</style>
