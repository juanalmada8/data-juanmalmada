---
import Etiqueta from "../Etiqueta.astro";
import Pipeline from "../Pipeline.astro";
---
<section id="sistema" class="seccion tema-pino" aria-labelledby="sistema-titulo">
  <div class="contenedor">
    <div class="cabecera" data-aparece>
      <Etiqueta class="minus">// cómo se arma el sistema</Etiqueta>
      <h2 id="sistema-titulo">Todo <em>conectado</em>.</h2>
      <p class="bajada">
        Si todo lo armo yo, las piezas se hablan entre sí y no pagás a nadie por coordinar.
      </p>
    </div>
    <div data-aparece>
      <Pipeline pasos={["tus datos y tareas", "se ordenan", "se conectan", "web, tablero y alertas", "tu negocio"]} />
    </div>
  </div>
</section>

<style>
  .cabecera { display: grid; gap: var(--space-4); max-width: 44rem; margin-bottom: var(--space-12); }
  .bajada { color: var(--crema); font-size: var(--fs-lead); }
</style>
