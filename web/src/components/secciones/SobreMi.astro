---
import Etiqueta from "../Etiqueta.astro";
import Firma from "../Firma.astro";
import Chip from "../Chip.astro";
import Sticker from "../Sticker.astro";
import Icono from "../Icono.astro";

const rasgos = [
  { nombre: "Detallista", texto: "Reviso cada número antes de que lo veas vos.", clase: "blanco" },
  { nombre: "Hiperactivo", texto: "Te respondo en menos de 24\u00a0h hábiles.", clase: "lima" },
  { nombre: "Extrovertido", texto: "Lo técnico, explicado en criollo.", clase: "musgo" },
];
---
<section id="sobre-mi" class="seccion tema-crema" aria-labelledby="sobre-mi-titulo">
  <div class="contenedor">
    <header class="cabecera" data-aparece>
      <Etiqueta numero="04">Sobre mí</Etiqueta>
      <div class="titulo-firma">
        <h2 id="sobre-mi-titulo">Hola, soy <em>Juanma</em>.</h2>
        <Firma color="pino" ancho="clamp(140px, 22vw, 220px)" decorativa />
      </div>
      <p class="lead">
        Hace 8&nbsp;años que trabajo con datos y armo webs y apps a medida. Estudié Sistemas en la UNLP.
        Trabajo remoto desde General Belgrano para quien lo necesite, esté donde esté.
      </p>
    </header>

    <ul class="rasgos">
      {rasgos.map((r) => (
        <li class:list={["rasgo", r.clase]} data-aparece>
          <h3>{r.nombre}</h3>
          <p>{r.texto}</p>
        </li>
      ))}
    </ul>

    <div class="fuera" data-aparece>
      <p class="mono fuera-tit">fuera_del_codigo()</p>
      <ul class="chips">
        <Chip as="li">hockey</Chip>
        <Chip as="li">cocina</Chip>
        <Chip as="li">rock nacional</Chip>
        <Chip as="li">viajes</Chip>
      </ul>
      <Sticker fondo="pino" giro={3} tam="5.5rem" class="sticker">
        <Icono variante="sin-fondo" ancho="100%" />
      </Sticker>
    </div>
  </div>
</section>

<style>
  .cabecera { display: grid; gap: var(--space-6); margin-bottom: var(--space-12); }
  .titulo-firma { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-8); }
  .lead { max-width: 44rem; }

  .rasgos { list-style: none; padding: 0; display: grid; gap: var(--space-4); }
  .rasgo {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    border-radius: var(--radius-card);
  }
  .rasgo h3 { font-size: var(--fs-h3); }
  .blanco { background: var(--blanco); border: var(--border-soft); }
  .lima { background: var(--lima); }
  .musgo { background: var(--musgo); color: var(--blanco); }

  .fuera {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-12);
  }
  .fuera-tit { font-size: var(--fs-small); color: var(--pino); font-weight: 500; }
  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); --texto-2: var(--musgo); }
  .fuera :global(.sticker) { margin-left: auto; }

  @media (min-width: 52rem) {
    .rasgos { grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
    .rasgo:nth-child(2) { transform: translateY(var(--space-6)); }
  }
</style>
