---
import Firma from "../Firma.astro";
import { sitio } from "../../data/sitio";
const rasgos = [
  { nombre: "Detallista", texto: "Reviso cada número antes de que lo veas vos.", tema: "pino" },
  { nombre: "Hiperactivo", texto: `Te respondo en ${sitio.respuesta}.`, tema: "lima" },
  { nombre: "Extrovertido", texto: "Lo técnico, explicado en criollo.", tema: "musgo" },
];
const fuera = [
  { nombre: "Hockey", texto: "Juego en equipo, también en los proyectos." },
  { nombre: "Cocina", texto: "Receta, ingredientes y tiempos: como un buen sistema." },
  { nombre: "Rock nacional", texto: "Y alternativo, de fondo mientras programo." },
  { nombre: "Viajes", texto: "Trabajar remoto también es esto." },
];
---
<section id="sobre-mi" class="seccion tema-crema" aria-labelledby="sobre-mi-titulo">
  <div class="contenedor">
    <div class="intro">
      <div class="tarjeta tema-pino" aria-hidden="true" data-aparece>
        <p class="mono lineas">
          <span>datos · web · nube</span>
          <span>8 años en datos</span>
          <span>General Belgrano → remoto</span>
        </p>
        <Firma color="lima" ancho="100%" decorativa />
      </div>
      <div class="texto" data-aparece>
        <p class="rotulo">06 — Sobre mí</p>
        <h2 id="sobre-mi-titulo">Hola, soy <span class="acento">Juanma</span>.</h2>
        <p class="lead">Hace 8&nbsp;años que trabajo con datos y armo webs y apps a medida. Estudié Sistemas en la UNLP.</p>
        <p>Trabajo remoto desde General Belgrano para quien lo necesite, esté donde esté.</p>
      </div>
    </div>

    <ul class="rasgos">
      {rasgos.map((r) => (
        <li class:list={["rasgo", `r-${r.tema}`]} data-aparece>
          <h3>{r.nombre}</h3>
          <p>{r.texto}</p>
        </li>
      ))}
    </ul>

    <p class="rotulo fuera-tit">Fuera del código</p>
    <ul class="fuera">
      {fuera.map((f) => (
        <li data-aparece>
          <h3>{f.nombre}</h3>
          <p>{f.texto}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .intro { display: grid; gap: var(--space-12); align-items: center; margin-bottom: var(--space-16); }
  .tarjeta {
    display: grid;
    gap: var(--space-8);
    padding: var(--space-8);
    border-radius: var(--radius-card);
    transform: rotate(-2deg);
    max-width: 24rem;
  }
  .lineas { display: grid; gap: var(--space-1); font-size: var(--fs-small); color: var(--salvia); }
  .texto { display: grid; gap: var(--space-4); }

  .rasgos { list-style: none; padding: 0; display: grid; gap: var(--space-4); }
  .rasgo { display: grid; gap: var(--space-2); padding: var(--space-6); border-radius: var(--radius-card); }
  .rasgo h3 { font-size: var(--fs-h3); }
  .r-pino { background: var(--pino); color: var(--crema); }
  .r-lima { background: var(--lima); color: var(--pino); transform: rotate(1deg); }
  .r-musgo { background: var(--musgo); color: var(--blanco); }

  .fuera-tit { margin: var(--space-16) 0 var(--space-4); }
  .fuera { list-style: none; padding: 0; display: grid; gap: var(--space-4); }
  .fuera li { display: grid; gap: var(--space-1); padding: var(--space-6); border: 2px solid var(--pino); border-radius: var(--radius-card); }
  .fuera p { font-size: var(--fs-small); }

  @media (min-width: 52rem) {
    .intro { grid-template-columns: 1fr 1.4fr; gap: var(--space-16); }
    .rasgos { grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
    .fuera { grid-template-columns: repeat(4, 1fr); }
  }
</style>
