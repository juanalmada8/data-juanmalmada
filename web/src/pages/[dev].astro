---
// /_tokens: hoja de tokens y componentes de marca. Solo existe en desarrollo (no sale en el build).
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import Icono from "../components/Icono.astro";
import Firma from "../components/Firma.astro";
import Etiqueta from "../components/Etiqueta.astro";
import Chip from "../components/Chip.astro";
import Boton from "../components/Boton.astro";
import Sticker from "../components/Sticker.astro";
import PatronM from "../components/PatronM.astro";
import Pipeline from "../components/Pipeline.astro";

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { dev: "_tokens" } }] : [];
}

const colores = ["pino", "musgo", "salvia", "crema", "lima", "blanco"];
const espacios = ["1", "2", "3", "4", "6", "8", "12", "16", "24"];
---
<Base titulo="Tokens · solo dev">
  <section class="seccion tema-crema">
    <div class="contenedor pila">
      <Etiqueta numero="00">Tokens</Etiqueta>
      <h1>Hoja de <em>tokens</em>.</h1>

      <h2>Color</h2>
      <div class="colores">
        {colores.map((c) => <div class="color" style={`background:var(--${c})`}><span class="mono">--{c}</span></div>)}
      </div>

      <h2>Tipografía</h2>
      <h1>H1 Un solo proveedor, <em>todo el sistema</em>.</h1>
      <h2>H2 ¿Qué <em>hago</em>?</h2>
      <h3>H3 Turnos y sistemas de gestión</h3>
      <p class="lead">Lead: Webs, apps y datos que trabajan por vos.</p>
      <p>Body: Lo que hoy te lleva una mañana por semana, que lo haga el sistema. 8&nbsp;años · 24/7.</p>
      <p class="mono">mono: SELECT turno, COUNT(*) AS total FROM agenda;</p>
      <Etiqueta numero="01">Logotipo</Etiqueta>

      <h2>Espaciado</h2>
      <div class="espacios">
        {espacios.map((s) => <div><span class="barra" style={`width:var(--space-${s})`}></span><span class="mono">--space-{s}</span></div>)}
      </div>
    </div>
  </section>

  <section class="seccion tema-pino">
    <div class="contenedor pila">
      <Logo variante="cursor" ancho="320px" />
      <div class="fila">
        <Logo variante="crema" ancho="160px" />
        <Logo variante="1tinta-crema" ancho="160px" />
        <Icono variante="circulo" ancho="64px" alt="" />
        <Icono variante="sin-fondo" ancho="48px" />
        <Icono variante="1tinta-crema" ancho="48px" />
        <Firma color="crema" />
        <Firma color="lima" />
      </div>
      <div class="fila">
        <Boton href="#">Escribime</Boton>
        <Boton href="#" variante="secundario">Ver proyectos</Boton>
        <Chip>web y apps</Chip><Chip>datos</Chip>
      </div>
      <Pipeline pasos={["tus datos y tareas", "se ordenan", "se conectan", "web / dashboard / alertas", "tu negocio"]} />
    </div>
  </section>
  <PatronM filas={2} lima={[[0, 3], [1, 7]]} />

  <section class="seccion tema-crema">
    <div class="contenedor fila">
      <Logo variante="pino" ancho="160px" />
      <Logo variante="1tinta-pino" ancho="160px" />
      <Icono variante="pino" ancho="48px" />
      <Firma color="pino" />
      <Sticker fondo="pino" giro={-4}><Icono variante="sin-fondo" ancho="100%" /></Sticker>
      <Sticker fondo="lima" giro={3}>todo el sistema</Sticker>
      <Sticker fondo="salvia" giro={-2}><Firma color="pino" ancho="100%" decorativa /></Sticker>
      <Boton href="#" variante="secundario">Secundario</Boton>
    </div>
  </section>
  <PatronM tono="crema" filas={2} />
</Base>

<style>
  .pila { display: grid; gap: var(--space-6); }
  .fila { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-6); }
  .colores { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: var(--space-4); }
  .color { height: 6rem; border-radius: var(--radius-card); border: var(--border-soft); display: flex; align-items: end; padding: var(--space-3); }
  .color span { background: var(--blanco); padding: 0 var(--space-1); font-size: var(--fs-label); }
  .espacios { display: grid; gap: var(--space-2); }
  .espacios div { display: flex; align-items: center; gap: var(--space-4); }
  .barra { display: inline-block; height: 1rem; background: var(--musgo); }
</style>
