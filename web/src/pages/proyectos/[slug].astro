---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Etiqueta from "../../components/Etiqueta.astro";
import Chip from "../../components/Chip.astro";
import Boton from "../../components/Boton.astro";
import { contacto } from "../../data/sitio";

export async function getStaticPaths() {
  const proyectos = await getCollection("proyectos", ({ data }) => data.publicado);
  return proyectos.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content } = await render(p);
---
<Base titulo={`${p.data.titulo} · Juanma`} descripcion={p.data.resultado}>
  <section class="seccion tema-pino">
    <div class="contenedor cabecera">
      <Etiqueta>{p.data.rubro} · {p.data.anio}</Etiqueta>
      <h1>{p.data.titulo}</h1>
      <p class="lead">{p.data.resultado}</p>
      <ul class="chips">{p.data.servicios.map((s) => <Chip as="li">{s}</Chip>)}</ul>
    </div>
  </section>
  {p.data.portada && (
    <div class="contenedor portada">
      <Image src={p.data.portada} alt={`Captura de ${p.data.titulo}`} widths={[480, 960, 1440]} sizes="(min-width: 72rem) 72rem, 100vw" />
    </div>
  )}
  <article class="seccion tema-crema">
    <div class="contenedor cuerpo">
      <Content />
    </div>
  </article>
  <section class="seccion tema-pino">
    <div class="contenedor cierre">
      <h2>¿Algo así para <em>tu negocio</em>?</h2>
      <Boton href={contacto.whatsapp} externo>Escribime</Boton>
    </div>
  </section>
</Base>

<style>
  .cabecera { display: grid; gap: var(--space-6); }
  .chips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .portada { margin-top: calc(-1 * var(--space-8)); }
  .portada :global(img) { border-radius: var(--radius-card); border: var(--border-soft); }
  .cuerpo { max-width: 46rem; display: grid; gap: var(--space-4); }
  .cuerpo :global(h2) { font-size: var(--fs-h3); margin-top: var(--space-8); }
  .cierre { display: grid; gap: var(--space-6); justify-items: start; }
</style>
