---
// Página de un caso publicado. Mismo editor: el caso se abre como un archivo más.
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const proyectos = await getCollection("proyectos", ({ data }) => data.publicado);
  return proyectos.map((p) => ({ params: { slug: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content } = await render(p);
---
<Base titulo={`${p.data.titulo} · Juanma`} descripcion={p.data.resultado}>
  <article class="caso contenedor">
    <p class="rotulo"><a href="/#proyectos">Proyectos</a> · {p.data.rubro}</p>
    <h1>{p.data.titulo}</h1>
    <p class="lead">{p.data.resultado}</p>
    {p.data.portada && <Image src={p.data.portada} alt={`Captura de ${p.data.titulo}`} widths={[480, 960, 1440]} sizes="(min-width: 60rem) 60rem, 100vw" />}
    <div class="texto"><Content /></div>
    <p><a class="boton" href="/#contacto">¿Algo así para vos? Escribime</a></p>
  </article>
</Base>

<style>
  .caso {
    padding-block: var(--space-12);
    display: grid;
    gap: var(--space-6);
  }
  .caso :global(img) { border-radius: var(--radius-card); border: var(--borde-suave); }
  .texto :global(h2) { font-size: var(--fs-h2); margin-top: var(--space-8); }
</style>
